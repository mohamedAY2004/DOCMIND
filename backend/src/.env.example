APP_NAME="docmind-api"
APP_VERSION="1.0.0"
APP_DESCRIPTION="DocMind backend (RAG tutor + document chat)"
APP_AUTHOR="your_name"

# Legacy RAG pipeline (kept for /api/v1/data/* and /api/v1/nlp/* internal routes)
FILE_ALLOWED_TYPES=["text/plain","application/pdf"]
FILE_MAX_SIZE=50 # 50MB
FILE_DEFAULT_CHUNK_SIZE=512000 # 512KB

# DocMind upload limits (spec §7.2 and §8.2.1). Values below are the defaults
# used when the env var is omitted.
UPLOAD_MATERIAL_MAX_MB=50
UPLOAD_DOC_MAX_MB=25
UPLOAD_DOC_MAX_FILES=5

DATABASE_URL="postgresql://your_username:your_password@localhost:5433/mini_rag"

#====================LLM Settings====================
GENERATION_BACKEND="GEMINI"
EMBEDDING_BACKEND="GEMINI"

GENERATION_MODEL_ID="YOUR_GENERATION_MODEL_ID"
EMBEDDING_MODEL_ID="YOUR_EMBEDDING_MODEL_ID"
EMBEDDING_SIZE=768

DEFAULT_INPUT_MAX_CHARACTERS=1024
DEFAULT_GENERATION_MAX_TOKENS=1000
DEFAULT_GENERATION_TEMPERATURE=0.1

GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
COHERE_API_KEY="YOUR_COHERE_API_KEY"
OPENAI_API_URL="https://api.openai.com/v1"

#====================VectorDB Settings====================
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_DISTANCE_METHOD="cosine"

#====================Agent (Agentic RAG) Settings====================
# Toggle the agentic layer. When false, the app keeps the classic
# always-retrieve RAG behaviour. When true, the agent decides per-turn.
AGENT_ENABLED=false
# Strategy; swap to a new value as new strategies are added under
# stores/agent/strategies (same factory pattern as LLM / VectorDB).
AGENT_STRATEGY="JSON_PLANNER"
AGENT_PLANNER_TEMPERATURE=0.0
AGENT_RETRIEVAL_LIMIT=5
AGENT_RETRIEVAL_THRESHOLD=0.3
AGENT_HISTORY_TURNS=6
# Phase 2 source scoping. Keep false until legacy materials are re-indexed
# (scripts/reindex_materials.py) so chunks carry a material_id to filter on.
AGENT_SOURCE_FILTER_ENABLED=false

#====================Reranking (Phase 3)====================
# Cross-encoder reranking of retrieved chunks before synthesis. Keep false to
# preserve the classic behaviour. The LOCAL_CROSS_ENCODER backend needs the
# optional dependency: `pip install sentence-transformers` (pulls in torch).
RERANK_ENABLED=false
RERANK_BACKEND="LOCAL_CROSS_ENCODER"
RERANK_MODEL_ID="BAAI/bge-reranker-base"
# Torch device: "cuda" | "cpu" | omit for auto-detect.
RERANK_DEVICE=
# Vector search fetches RERANK_OVERFETCH x limit candidates; reranker keeps limit.
RERANK_OVERFETCH=3
# Final cap on reranked chunks; omit to default to the caller's limit.
RERANK_TOP_N=

#====================MMR Diversity (Phase 4)====================
# Maximal Marginal Relevance prefilter: over-fetch MMR_OVERFETCH x keep raw
# candidates, select a diverse pool on vector cosine similarity, then hand it
# to the reranker (if enabled). Keep false to preserve the classic behaviour.
MMR_ENABLED=false
# 1.0 = pure relevance (vector order), lower = more diversity. Default 0.7.
MMR_LAMBDA=0.7
# Vector search fetches MMR_OVERFETCH x keep raw candidates for MMR to choose from.
MMR_OVERFETCH=5

#====================Template Settings====================
DEFAULT_LANGUAGE="en"

#====================Auth (spec §2.1) ====================
# MUST be overridden in production. 32+ random bytes recommended.
JWT_SECRET="CHANGE_ME_32_BYTES_OF_ENTROPY"
JWT_ALG="HS256"
JWT_EXPIRE_MINUTES=720
BCRYPT_ROUNDS=12

#====================CORS (spec §2.5) ====================
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:8080","http://localhost:8080"]

#====================Student Access (spec §2.3) ====================
STUDENT_ACCESS_DEFAULT_ENABLED=true

#====================Campus pilot security and rollout====================
ENVIRONMENT="development"
LOCAL_AUTH_ENABLED=true
ACCESS_COOKIE_MINUTES=15
REFRESH_COOKIE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
REDIS_URL="redis://localhost:6379/0"

PORTAL_SSO=false
PORTAL_SSO_URL="http://localhost:8081/sso"
# 32+ random bytes; shared only with the trusted portal server.
PORTAL_SSO_SECRET="CHANGE_ME_PORTAL_SECRET_32_BYTES"

STRUCTURED_CITATIONS=true
STREAMING_CHAT=true
SUBJECT_READINESS=true

# local | s3. S3 works with AWS S3, MinIO, R2, and compatible services.
STORAGE_BACKEND="local"
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Leave false for the first reporting week, then enable deletion.
RETENTION_DELETE_ENABLED=false
RETENTION_INTERVAL_SECONDS=86400
EVALUATION_CASE_RETRIES=3
EVALUATION_RUN_STALE_MINUTES=15
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
CHAT_RATE_LIMIT=60
CHAT_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SECONDS=3600
MAX_CONCURRENT_GENERATIONS=2
GENERATION_SLOT_TTL_SECONDS=600
